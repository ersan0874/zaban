DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=zaban
DB_SYNC=true
PORT=3000
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
ENERGY_CAP=25
ENERGY_REGEN_MINUTES=5
ENERGY_STEP_COST=1
ENERGY_COMBO_LENGTH=5
ENERGY_COMBO_REWARD_MIN=1
ENERGY_COMBO_REWARD_MAX=3
ENERGY_COMBO_REWARD_MIN_STEP=1
ENERGY_COMBO_REWARD_MAX_STEP=2

# Redis (BullMQ queue). Docker Compose sets redis://redis:6379 itself.
REDIS_URL=redis://localhost:6379

# AI content pipeline (Gemini). Never commit a real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_MODEL_LITE=gemini-flash-lite-latest
# Requests per minute sent to Gemini (free tier is low)
GEMINI_RPM=10
GEMINI_TIMEOUT_MS=180000
# Run the AI queue worker in this process (API in dev; `worker` service in Docker)
AI_WORKER_ENABLED=true
UPLOAD_DIR=storage/uploads
CONTENT_PDF_PAGES_PER_CALL=8
# Second AI pass that double-checks generated answers
CONTENT_AI_REVIEW=true
# Essay answers graded by AI per learner per day
ESSAY_AI_DAILY_LIMIT=50

# Admin Next.js (admin/.env.local)
# NEXT_PUBLIC_API_URL=http://localhost:3000/api
